# Production / staging base URL for Tashil Data Sharing smoke checks.
# Copy to scripts/smoke.env (gitignored locally if desired) or export before running:
#   export BASE_URL=https://www.data.sw-point.com
#   export TENANT_PATH=/adeco
#
# Live site (canonical for smoke / e2e baseURL):
BASE_URL=https://www.data.sw-point.com

# Default tenant portal path on prod (Adeco). Smoke GETs this path only.
TENANT_PATH=/adeco

# Optional: direct Cloud Run backend (Flutter also uses this via BACKEND_URL dart-define).
# BACKEND_URL=https://tashil-backend-564362209163.europe-west1.run.app

# Policy: prod smoke/e2e must stay read-only / non-destructive unless Mohamed
# explicitly approves writes. Do not add delete/upload/commit calls here.
